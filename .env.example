# Copy this file to .env.local for local development. Never commit real credentials.
# DATABASE_URL matches the local PostgreSQL in compose.yaml.
DATABASE_URL=postgres://titipdong:titipdong@localhost:5432/titipdong?sslmode=disable
JWT_SECRET=generate-a-random-32-byte-secret
PORT=8080
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
