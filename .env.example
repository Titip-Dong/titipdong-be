# Copy this file to .env for local development. Never commit real credentials.
# Port 5433 avoids a local PostgreSQL service that may already use port 5432.
DATABASE_URL=postgres://titipdong:titipdong-dev@127.0.0.1:5433/titipdong?sslmode=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=8080
LOG_LEVEL=info
LOG_FILE=logs/api.jsonl
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
PAYMENT_GATEWAY=fake
# Azurite from compose.yaml (public development key). Leave empty to disable uploads.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
BLOB_CONTAINER=uploads
BLOB_PUBLIC_URL=

# Used to initialize the local PostgreSQL Docker container; must match DATABASE_URL.
POSTGRES_DB=titipdong
POSTGRES_USER=titipdong
POSTGRES_PASSWORD=titipdong-dev
POSTGRES_PORT=5433

# Used by the local monitoring stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
